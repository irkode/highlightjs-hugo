{{- /* printf, not jsonify: one line per function keeps diffs single-line */ -}}
{{- $functions := partialCached "get-functions.html" "functions" }}
{{- $lines := slice }}
{{- range $name, $entry := $functions }}
   {{- $aliases := slice }}
   {{- range $entry.aliases }}
      {{- $aliases = $aliases | append (printf "%q" .) }}
   {{- end }}
   {{- $lines = $lines | append (printf "  %q: { \"section\": %q, \"aliases\": [%s] }" $name $entry.section (delimit $aliases ", ")) }}
{{- end }}
{{- printf "{\n%s\n}\n" (delimit $lines ",\n") }}
